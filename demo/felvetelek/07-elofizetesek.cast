[20.944696, "o", "\u001b[2m    ellenorzo.py\u001b[0m\r\n"]
[20.964928, "o", "\u001b[2m    ---\u001b[0m\r\n"]
[20.984985, "o", "\u001b[2m    #!/usr/bin/env python3\u001b[0m\r\n"]
[21.005145, "o", "\u001b[2m    \"\"\"Determinisztikus ellenőrző: kategória-összegek, terv-tény, duplikátumok.\u001b[0m\r\n"]
[21.025283, "o", "\u001b[2m    \u001b[0m\r\n"]
[21.045403, "o", "\u001b[2m    A harness alapelve: a modell sosem számol — ez a szkript számol helyette,\u001b[0m\r\n"]
[21.065566, "o", "\u001b[2m    fillérre pontosan (Decimal). Az agent ennek a kimenetét értelmezi, felül\u001b[0m\r\n"]
[21.085667, "o", "\u001b[2m    nem bírálhatja.\u001b[0m\r\n"]
[21.105871, "o", "\u001b[2m    \u001b[0m\r\n"]
[21.125997, "o", "\u001b[2m    Használat:\u001b[0m\r\n"]
[21.146148, "o", "\u001b[2m      python3 ellenorzo.py <kassza.csv> [--terv <terv.csv>] [--honap 2026-07]\u001b[0m\r\n"]
[21.166317, "o", "\u001b[2m    \u001b[0m\r\n"]
[21.186493, "o", "\u001b[2m    CSV formátum (pontosvesszős):\u001b[0m\r\n"]
[21.206637, "o", "\u001b[2m      kassza: datum;leiras;osszeg;kategoria;forras\u001b[0m\r\n"]
[21.226822, "o", "\u001b[2m      terv:   kategoria;keret\u001b[0m\r\n"]
[21.247013, "o", "\u001b[2m    \"\"\"\u001b[0m\r\n"]
[21.267142, "o", "\u001b[2m    import argparse\u001b[0m\r\n"]
[21.287239, "o", "\u001b[2m    import csv\u001b[0m\r\n"]
[21.307364, "o", "\u001b[2m    import sys\u001b[0m\r\n"]
[21.327526, "o", "\u001b[2m    from collections import Counter, defaultdict\u001b[0m\r\n"]
