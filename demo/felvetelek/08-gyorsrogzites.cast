[45.334237, "o", "\u001b[2m    #!/usr/bin/env python3\u001b[0m\r\n"]
[45.354383, "o", "\u001b[2m    \"\"\"Determinisztikus ellenőrző: kategória-összegek, terv-tény, duplikátumok.\u001b[0m\r\n"]
[45.374523, "o", "\u001b[2m    \u001b[0m\r\n"]
[45.394709, "o", "\u001b[2m    A harness alapelve: a modell sosem számol — ez a szkript számol helyette,\u001b[0m\r\n"]
[45.414845, "o", "\u001b[2m    fillérre pontosan (Decimal). Az agent ennek a kimenetét értelmezi, felül\u001b[0m\r\n"]
[45.434964, "o", "\u001b[2m    nem bírálhatja.\u001b[0m\r\n"]
[45.455172, "o", "\u001b[2m    \u001b[0m\r\n"]
[45.475268, "o", "\u001b[2m    Használat:\u001b[0m\r\n"]
[45.495493, "o", "\u001b[2m      python3 ellenorzo.py <kassza.csv> [--terv <terv.csv>] [--honap 2026-07]\u001b[0m\r\n"]
[45.515671, "o", "\u001b[2m    \u001b[0m\r\n"]
[45.535739, "o", "\u001b[2m    CSV formátum (pontosvesszős):\u001b[0m\r\n"]
[45.555952, "o", "\u001b[2m      kassza: datum;leiras;osszeg;kategoria;forras\u001b[0m\r\n"]
[45.57609, "o", "\u001b[2m      terv:   kategoria;keret\u001b[0m\r\n"]
[45.596271, "o", "\u001b[2m    \"\"\"\u001b[0m\r\n"]
[45.616416, "o", "\u001b[2m    import argparse\u001b[0m\r\n"]
[45.636591, "o", "\u001b[2m    import csv\u001b[0m\r\n"]
[45.656772, "o", "\u001b[2m    import sys\u001b[0m\r\n"]
[45.676962, "o", "\u001b[2m    from collections import Counter, defaultdict\u001b[0m\r\n"]
[45.697143, "o", "\u001b[2m    from decimal import Decimal, InvalidOperation\u001b[0m\r\n"]
[45.717263, "o", "\u001b[2m    \u001b[0m\r\n"]
[45.737459, "o", "\u001b[2m    BEVETEL_KAT = \"bevetel\"\u001b[0m\r\n"]
[45.757664, "o", "\u001b[2m    ATVEZETES_KAT = {\"megtakaritas\", \"atvezetes\"}\u001b[0m\r\n"]
[78.453559, "o", "\u001b[2m\u001b[36m  » Edit\u001b[0m\u001b[2m  /home/user/otthon/kockas-fuzet/penzugy/kassza.csv\u001b[0m\r\n"]
